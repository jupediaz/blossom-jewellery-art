# Monorepo root — app-specific ignores live in each app's own .gitignore

# Dependencies
node_modules/

# Turborepo
.turbo/

# Build outputs
dist/
.next/

# Env
.env
.env.local
.env.*.local

# OS / editor
.DS_Store
*.tsbuildinfo

# Test / tooling artifacts
playwright-report/
test-results/
screenshots/
.playwright-mcp/
*.png

# The global ~/.gitignore_global has `*password*` (security rule) which silently
# excludes legit source code under password-named routes. Re-include source so
# the password-recovery flow (incl. admin reset) is tracked.
!**/*password*/
!**/*password*/**
!**/src/**/*password*
